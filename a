    const data = Object.fromEntries(fd.entries());
    saveApplicant(data);
  };
}

function closeModal() {
  document.getElementById('overlay').classList.remove('open');
}

/* ============ 7. تصدير البيانات إلى ملف Excel ============ */
function exportToExcel(govFilter = null) {
  let dataToExport = allApplicants;
  if (govFilter) {
    dataToExport = dataToExport.filter(a => a.governorate === govFilter);
  }

  if(!dataToExport.length) {
    toast('لا توجد بيانات لتصديرها', 'err');
    return;
  }

  const rows = dataToExport.map(a => ({
    'الرقم المعرف': a.id,
    'الاسم الكامل': a.full_name,
    'الرقم القومي': a.national_id,
    'الهاتف': a.phone,
    'المحافظة': a.governorate,
    'المركز / الحي': a.district,
    'المؤهل الدراسي': a.qualification,
    'حالة التواصل': a.status,
    'الملاحظات': a.notes,
    'تاريخ التسجيل': a.created_at
  }));

  const worksheet = XLSX.utils.json_to_sheet(rows);
  const workbook = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(workbook, worksheet, "المتقدمين");

  const fileName = govFilter ? `متقدمو_${govFilter}.xlsx` : `جميع_المتقدمين_المشروع.xlsx`;
  XLSX.writeFile(workbook, fileName);
}

